# =====================================================================
# ROOT .htaccess — blog platform
# DocRoot should point at /public. If your host forces docroot=/, this
# file forwards everything into /public instead.
# =====================================================================

# ---------- 1. Route everything through /public (shared-hosting fallback) ----------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the app lives in a subfolder, uncomment:
    # RewriteBase /

    # Forward to public/ when docroot is the project root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d [OR]
    RewriteRule !^public/ public/index.php [L]
</IfModule>

# ---------- 2. Deny access to non-public code ----------
<FilesMatch "\.(env|md|sql|log|ini|bak)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(app|config|database|storage|admin/views|admin/controllers)/
RedirectMatch 404 /\.git

# ---------- 3. Security headers ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-XSS-Protection "1; mode=block"
    # CSP: no inline scripts except theme bootstrap; CDN editor/fonts allowed.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.tiny.cloud https://cdn.jsdelivr.net https://www.googletagmanager.com; font-src 'self' data: https://cdn.jsdelivr.net; frame-src https://www.youtube.com https://player.vimeo.com; connect-src 'self'; base-uri 'self'; form-action 'self'"
    # Enable HSTS only when you serve HTTPS exclusively:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------- 4. Gzip compression ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- 5. Browser caching ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 30 days"
    ExpiresByType application/javascript  "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ---------- 6. Misc hardening ----------
Options -Indexes
ServerSignature Off
DirectoryIndex index.php index.html

# PHP upload limits (where allowed as overrides)
<IfModule mod_php.c>
    php_value upload_max_filesize 4M
    php_value post_max_size 8M
</IfModule>

ErrorDocument 404 /index.php
