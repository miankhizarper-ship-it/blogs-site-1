# ============================================================
# COPY THIS FILE TO  config/.env  AND FILL IN REAL VALUES
# NEVER COMMIT .env TO GIT
# ============================================================

APP_NAME="My Blog"
APP_ENV=production
APP_DEBUG=true   # set back to false once the 502 is resolved — it prints the real PHP error instead of a blank page

# Your live site URL (no trailing slash). Leave EMPTY to auto-detect.
APP_URL=https://blog-site.ct.ws

APP_TIMEZONE=UTC

# ---------- MySQL / MariaDB (alwaysdata) ----------
DB_HOST=mysql-khizar.alwaysdata.net
DB_PORT=3306
DB_NAME=khizar_blogs-site
DB_USER=khizar_
DB_PASS=PASTE_YOUR_ALWAYS_DATA_DB_PASSWORD_HERE
DB_CHARSET=utf8mb4

# ---------- Session ----------
SESSION_NAME=blogsid
SESSION_LIFETIME=7200

# ---------- Mail ----------
ADMIN_EMAIL=admin@site.com
MAIL_FROM=noreply@blog-site.ct.ws
